#!/usr/bin/env bash

# This is an example makemakerc
# it will list all variables and functions that you may customise to change
# your experience with the makemake script or its derivatives. no options are
# required unless otherwise noted.

# makemake_theme decides what theme to use
# DEFAULT: dune
# OPTIONS: dune doom
#makemake_theme="dune"

# makefile determines the name of the output object, the makefile. this can be
# any valid filename. it is highly recommended to use "makefile" or "Makefile"
# DEFAULT: makefile
# OPTIONS: [any valid filename]
#makefile="makefile"

# prelude determines the opening message, before the script does its thing.
# can be set to "" to fully remove the opening message.
# NOTE: the prelude is put to the screen as follows: echo -n "${prelude}"
# DEFAULT: [depends on theme]
# OPTIONS: [any valid filename]
#prelude="makefiles are awesome"$'\n'

# savefile determines where makemake will store variables that rarely change
# between executions, such as the source directories, or what language the
# project is written in
# DEFAULT: [depends on theme]
# OPTIONS: [any valid filename]
#savefile="makemake_savefile"

# maker_header determines what header will be put into the generated makefile
# can be set to "" to fully remove the header
# DEFAULT: [depends on theme]
# OPTIONS: [any string]
#maker_header="# this is a makefile generated by makemake!"

# the default_ series of declarations are bash functions that outputs a string
# to stdout.
# whenever prompted for whatever they are the default for, the default name will
# be the stdout of the function (e.g. default_targetbin() for the default
# makefile target)
# DEFAULT: default_targetbin(){ basename `realpath .` }
# DEFAULT: default_bindir() { echo -n "bin/" }
# DEFAULT: default_depdir() { echo -n "dep/" }
# DEFAULT: default_libdir() { echo -n "lib/" }
# OPTIONS: [any function that outputs to stdout]
#default_targetbin() { ... }
#default_bindir() { ... }
#default_depdir() { ... }
#default_libdir() { ... }

# targetbin will be prompted if unset
# DEFAULT: [unset]
# OPTIONS: [any valid filename]
#targetbin=`default_targetbin`

# language will be prompted if unset
# NOTE: if not unset, flags must also be set
# DEFAULT: [unset]
# OPTIONS: c cpp
#language=c

# flags will only be prompted if language is unset.
# setting flag to a value will cause makemake to skip setting it itself.
# DEFAULT: [unset]
# OPTIONS: [any valid cc flags]
#flags="-Wall -Wextra -Werror -Wpedantic"

# standard is used to determine wether a specific standard is needed for your
# project.
# DEFAULT: [unset]
# OPTIONS: y n
#standard="y"

# if standard is set, c_standard will be appended to flags in c projects
# NOTE: will not be appended to flags if language is predefined
# DEFAULT: [unset]
# OPTIONS: --std=[any c standard]
#c_standard="--std=c11"

# if standard is set or chosen, cpp_standard will be appended to flags in cpp
# projects
# NOTE: will not be appended to flags if language is predefined
# DEFAULT: --std=c++98
# OPTIONS: --std=[any cpp standard]
#cpp_standard="--std=c++98"

# bindir will be prompted if unset
# DEFAULT: [unset]
# OPTIONS: [any valid directory name ending in "/"]
#bindir="obj/"

# depdir will be prompted if unset
# DEFAULT: [unset]
# OPTIONS: [any valid directory name ending in "/"]
#depdir="dependencies/"

# has_libs will be prompted if unset
# DEFAULT: [unset]
# OPTIONS: true false
#has_libs="false"

# libdir will be prompted if libdir is unset and has_libs is unset or true
# DEFAULT: [unset]
# OPTIONS: [any valid directory name ending in "/"]
#libdir="libraries/"

# srcdirs will be prompted if unset
# DEFAULT: [unset]
# OPTIONS: [a bash array of valid directory names ending in "/"]
#srcdirs=( "./" "src/" "testing/" )

# incdirs will be prompted if unset
# DEFAULT: [unset]
# OPTIONS: [a bash array of valid directory names ending in "/"]
#incdirs=( "./" "inc/" "lib/libex/include" )

# It is not recommended to change any further variables used in makemake.
